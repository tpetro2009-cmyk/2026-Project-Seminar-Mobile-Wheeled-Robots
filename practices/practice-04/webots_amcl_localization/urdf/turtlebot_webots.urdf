
<?xml version="1.0"?>
<robot name="turtlebot3_burger">

    <!-- Основные звенья -->
    <link name="base_link"/>
    <link name="left_wheel_link"/>
    <link name="right_wheel_link"/>
    <link name="imu_link"/>

    <!-- Левое колесо -->
    <joint name="left wheel motor" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.08 0.033" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Правое колесо -->
    <joint name="right wheel motor" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.08 0.033" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- IMU -->
    <joint name="imu_fixed_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

    <!-- Настройки Webots -->
    <webots>
        <device reference="LDS-01" type="Lidar">
            <ros>
                <enabled>true</enabled>
                <updateRate>5</updateRate>
                <topicName>/scan</topicName>
                <alwaysOn>false</alwaysOn>
                <frameName>LDS-01</frameName>
            </ros>
        </device>

        <plugin type="webots_ros2_driver::Ros2IMU">
            <enabled>true</enabled>
            <updateRate>20</updateRate>
            <topicName>/imu</topicName>
            <alwaysOn>false</alwaysOn>
            <frameName>imu_link</frameName>
            <inertialUnitName>inertial_unit</inertialUnitName>
            <gyroName>gyro</gyroName>
            <accelerometerName>accelerometer</accelerometerName>
        </plugin>

        <plugin type="webots_ros2_control::Ros2Control"/>
    </webots>

    <!-- Интерфейсы управления Webots -->
    <ros2_control name="WebotsControl" type="system">
        <hardware>
            <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
        </hardware>

        <joint name="right wheel motor">
            <state_interface name="position"/>
            <command_interface name="velocity"/>
        </joint>

        <joint name="left wheel motor">
            <state_interface name="position"/>
            <command_interface name="velocity"/>
        </joint>
    </ros2_control>

</robot>
